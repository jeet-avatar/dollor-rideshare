# Copy to fastlane/.env.default (gitignored) or export these in your shell. Never commit real values.
# App Store Connect API key (Users and Access > Integrations > App Store Connect API)
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# Read by the customer/delivery Fastfiles and the root Fastfile
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Absolute path to the AuthKey_<KEYID>.p8 file kept OUTSIDE the repo (e.g. ~/.private_keys/)
APP_STORE_CONNECT_API_KEY_PATH=
