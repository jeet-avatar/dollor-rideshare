	<string>Microphone access enables voice commands and voice messages for hands-free operation while driving.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo library access allows you to upload profile photos and driver documentation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voice commands allow hands-free control while driving - accept rides, navigate, and send messages safely.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
