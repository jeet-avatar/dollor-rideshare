	<array>
		<string>comgooglemaps</string>
		<string>tel</string>
		<string>sms</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Camera access allows you to take profile photos and scan documents for driver verification.</string>
	<key>NSContactsUsageDescription</key>
	<string>Contacts access allows you to quickly call riders from your contacts.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Dollor AI Service needs your location to track rides in real-time and provide accurate updates to riders even when the app is in the background.</string>
