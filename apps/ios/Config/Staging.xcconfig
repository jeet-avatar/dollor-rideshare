// Staging Environment Configuration
// Used for QA testing and pre-production validation

// Environment
ENVIRONMENT = Staging
API_BASE_URL = https:/$()/api.dollor.ai
ENABLE_DEBUG_LOGGING = YES
ENABLE_MOCK_DATA = NO

// App Settings
IS_DUMMY_PAYMENT_MODE = NO
ENABLE_AI_FEATURES = YES
ENABLE_DYNAMIC_PRICING = YES

// Bundle ID Suffix (for separate installs)
BUNDLE_ID_SUFFIX = .staging
APP_DISPLAY_NAME_SUFFIX = (Staging)

// Firebase Project
FIREBASE_PROJECT = dollor-staging

// Feature Flags
ENABLE_ANALYTICS = YES
ENABLE_CRASH_REPORTING = YES
ENABLE_PERFORMANCE_MONITORING = YES

// Code Signing (Distribution for TestFlight)
CODE_SIGN_IDENTITY = Apple Distribution
DEVELOPMENT_TEAM = $(DEVELOPMENT_TEAM)

// Build Settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL = -O
GCC_OPTIMIZATION_LEVEL = s
ENABLE_TESTABILITY = NO

// Server URLs (single production backend; ws/cdn hosts do not exist)
WEBSOCKET_URL = wss:/$()/api.dollor.ai
CDN_URL = https:/$()/api.dollor.ai
