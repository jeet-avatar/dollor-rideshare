# =============================================================================
# DOLLOR.AI P2P PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#
# Environment Types:
#   - development/local/dev: Local development (permissive CORS for local origins)
#   - staging: Staging environment
#   - production/prod: Production (default if not set)
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development, staging, production (default: production)
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
# Local:      postgresql://postgres:postgres@<your-db-host>:5432/dollor_db
# Staging:    postgresql://user:pass@staging-db.dollor.ai:5432/dollor_staging
# Production: postgresql://user:pass@prod-db.dollor.ai:5432/dollor_production
DATABASE_URL=postgresql://postgres:postgres@<your-db-host>:5432/dollor_db

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING
# -----------------------------------------------------------------------------
# Test keys for development, live keys for production
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# AWS S3 / CLOUDFRONT (File Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=dollor-ai-uploads
AWS_REGION=us-east-1

# CDN URL for serving uploaded files
# Development: Leave empty to use local uploads
# Production: https://cdn.dollor.ai
CDN_BASE_URL=

# Local upload directory (used when S3 is not configured)
# Default: /tmp/dollor_uploads
LOCAL_UPLOAD_DIR=/tmp/dollor_uploads

# -----------------------------------------------------------------------------
# DOCUMENT VERIFICATION SERVICES
# -----------------------------------------------------------------------------
# Persona - Identity & Business Document Verification
# Get keys from: https://withpersona.com/dashboard
PERSONA_API_KEY=persona_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERSONA_TEMPLATE_ID=tmpl_xxxxxxxxxxxxxxxxxxxxxxxx
PERSONA_WEBHOOK_SECRET=

# Onfido - Identity Verification (Alternative)
# Get keys from: https://dashboard.onfido.com
ONFIDO_API_KEY=api_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ONFIDO_WEBHOOK_SECRET=

# Veriff - Identity Verification (Alternative)
# Get keys from: https://station.veriff.com
VERIFF_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VERIFF_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# MICROSERVICES (Optional - for distributed deployment)
# -----------------------------------------------------------------------------
# Leave as-is for monolith deployment, or set URLs for microservice deployment
# Docker/K8s: Use service names (e.g., http://auth-service:8001)
# Local: use the host and port each service listens on
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
DRIVER_SERVICE_URL=http://driver-service:8003
RESTAURANT_SERVICE_URL=http://restaurant-service:8004
ORDER_SERVICE_URL=http://order-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
LOCATION_SERVICE_URL=http://location-service:8007
MENU_SERVICE_URL=http://menu-service:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8009
RATING_SERVICE_URL=http://rating-service:8010
ANALYTICS_SERVICE_URL=http://analytics-service:8011
PRICING_SERVICE_URL=http://pricing-service:8012
NEGOTIATION_SERVICE_URL=http://negotiation-service:8013
RIDE_SERVICE_URL=http://ride-service:8014
CHAT_SERVICE_URL=http://chat-service:8015
CALL_SERVICE_URL=http://call-service:8016

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@dollor.ai
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Dollor.ai

# -----------------------------------------------------------------------------
# GOOGLE MAPS API
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# FIREBASE / FCM (Push Notifications)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dollorai-production
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# -----------------------------------------------------------------------------
# PLATFORM CONFIGURATION
# -----------------------------------------------------------------------------
# Dollor.ai Matchmaking Fees (flat $1 model)
PLATFORM_FEE_RATE=0.0
PLATFORM_FLAT_FEE=1.00
TAX_RATE=0.08
DELIVERY_FEE_BASE=2.99
DELIVERY_FEE_PER_MILE=0.50

# -----------------------------------------------------------------------------
# COUPA INTEGRATION (Optional - Enterprise)
# -----------------------------------------------------------------------------
COUPA_API_URL=https://your-instance.coupahost.com/api
COUPA_API_KEY=your-coupa-api-key-here

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTRATION_REQUESTS=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=300
